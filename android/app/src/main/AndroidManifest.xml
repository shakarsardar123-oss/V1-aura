<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══ AURA Permission Declarations ════════════════════════════ -->
    <!-- Each permission below is required by a specific AURA feature. -->
    <!-- See AURA_PERMISSION_FINAL_VERIFICATION.md for full mapping. -->

    <!-- ── Network (normal – auto-granted, never shown in Settings) ── -->
    <!-- Used by: AI API calls, connectivity checks, URL tools -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Microphone (runtime – shown as "Microphone" in Settings) ── -->
    <!-- Used by: Voice recognition, wake-word, speech_to_text -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ── Camera (runtime – shown as "Camera" in Settings) ── -->
    <!-- Used by: Vision tools (read_text, analyze_vision, find_object, etc.) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ── Notifications (runtime – shown as "Notifications" on Android 13+) ── -->
    <!-- Used by: Alarm reminders, local notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Foreground Service (normal – auto-granted, never shown) ── -->
    <!-- Used by: Continuous listening, wake-word detection -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ type declaration for mic-type FG service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ── Boot (normal – auto-granted, never shown in Settings) ── -->
    <!-- Used by: Alarm rescheduling after reboot (AlarmBootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Wake Lock (normal – auto-granted, never shown in Settings) ── -->
    <!-- Used by: android_alarm_manager_plus wakeup alarms -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Exact Alarm (special – shown in "Alarms & reminders" on Android 12+) ── -->
    <!-- SCHEDULE_EXACT_ALARM: user-grantable on Android 12+ via Settings → Alarms & reminders -->
    <!-- Used by: android_alarm_manager_plus exact alarm scheduling -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- NOTE: USE_EXACT_ALARM removed. It is only for alarm-clock apps and would
         conflict with SCHEDULE_EXACT_ALARM. Google Play may reject non-alarm apps
         that declare USE_EXACT_ALARM without justification. -->

    <!-- ── System Alert Window (special – shown as "Display over other apps") ── -->
    <!-- Used by: Floating AURA overlay (floating_aura platform channel) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ── Full-Screen Intent (special – shown as "Full-screen notifications" on Android 14+) ── -->
    <!-- REQUIRED: AlarmNotificationService uses fullScreenIntent:true to show
         alarm over lock screen. Android 14+ requires this permission declaration.
         Without it, full-screen notifications silently fail on Android 14+. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ── Battery Optimization Bypass (special – shown in "Battery → Unrestricted") ── -->
    <!-- Used by: Foreground service keep-alive, reliable alarm delivery.
         AURA's permission rationale sheet (Kurdish Sorani) already includes
         explanation text for ignoreBatteryOptimizations. The features layer
         maps foreground_service → batteryOptimization. Without this declaration,
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS intent will crash. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ── Vibrate (normal – auto-granted, never shown in Settings) ── -->
    <!-- Used by: Alarm haptic feedback, vibration tool -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── REMOVED: FLASHLIGHT ── -->
    <!-- FLASHLIGHT is a legacy permission that does nothing on Android 6+.
         Camera flash is controlled via the CAMERA permission + hardware API. -->

    <!-- ── REMOVED: USE_EXACT_ALARM ── -->
    <!-- See note above. Only for alarm-clock category apps on Google Play. -->

    <!-- ══ NOT ADDED: Storage permissions ─═ -->
    <!-- READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_MEDIA_AUDIO (Android 13+)
         and READ_EXTERNAL_STORAGE (Android 12-):
         AURA's core tools do NOT access shared/external storage. path_provider
         uses app-internal directories only. The features/ layer defines
         file_storage → storage, but no core tool actually reads/writes media
         files. Adding these without real usage would be permission bloat.
         If file_storage feature is implemented in the future, add:
           READ_MEDIA_IMAGES, READ_MEDIA_VIDEO, READ_MEDIA_AUDIO (API 33+)
           READ_EXTERNAL_STORAGE (API <33, maxSdkVersion 32) -->

    <!-- ══ NOT ADDED: Location permissions ─═ -->
    <!-- ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION:
         AURA's core tools do NOT use location. The system_settings_tool can
         open the Location settings page (Intent), but does not read location
         data. The features/ layer defines location_services → location, but
         no core tool calls GPS. Adding without real usage = permission bloat.
         If location feature is implemented in the future, add both. -->

    <!-- ══ NOT ADDED: Contacts / Phone ─═ -->
    <!-- READ_CONTACTS / CALL_PHONE:
         AURA's core tools do not access contacts or make phone calls.
         ToolPermission.contacts and ToolPermission.phone exist in the
         security policy but no tool requires them. Adding without usage
         = permission bloat. -->

    <!-- ══ NOT ADDED: AccessibilityService ─═ -->
    <!-- DevicePermission.accessibility exists in features/ but there is no
         Manifest <service> declaration, no res/xml/accessibility_service_config.xml,
         and no Kotlin handler in MainActivity.kt. This is a features/ concern,
         not a core/ concern. Documented only. -->

    <!-- ══ NOT ADDED: FOREGROUND_SERVICE_CAMERA, FOREGROUND_SERVICE_LOCATION, ─═ -->
    <!-- FOREGROUND_SERVICE_CONNECTED_DEVICE ── -->
    <!-- AURA does not currently start foreground services with camera, location,
         or connected-device types. If added in the future, these type-specific
         permissions are required on Android 14+. -->

    <!-- ── Feature declarations for Store compliance ── -->
    <!-- Camera is optional (vision features) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Microphone is optional (voice features) -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="AURA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Boot receiver for alarm rescheduling -->
        <receiver
            android:name=".AlarmBootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
